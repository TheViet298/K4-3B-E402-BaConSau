# ===================================================================
# OpenRouter API Configuration (VLearn Track D2 - Eval Benchmark)
# ===================================================================

# Điền OpenRouter API Key của bạn vào đây (bắt đầu bằng sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model muốn dùng trên OpenRouter (ví dụ: google/gemini-2.0-flash-001, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Endpoint mặc định của OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# (Tùy chọn) Nếu dùng trực tiếp OpenAI hoặc Gemini API:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
